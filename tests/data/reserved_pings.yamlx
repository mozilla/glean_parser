---
$schema: moz://mozilla.org/schemas/glean/pings/2-0-0

# A list of all reserved ping names.
# This is verified in a test to match the list of defined reserved pings.

metrics:
  &common
  description: A ping
  include_client_id: true
  bugs:
    - https://example.com/bugs
  data_reviews:
    - https://example.com/reviews
  notification_emails:
    - CHANGE-ME@test-only.com

baseline: *common
events: *common
deletion-request: *common
default: *common
server-deletion-request: *common
tags: *common
pings: *common
health: *common
